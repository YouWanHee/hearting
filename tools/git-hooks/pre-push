#!/bin/sh
# Refuse a push that the Checks "adaptation-boundary" job would fail.
#
# CI runs these static checks and fails the whole run when one of them does.
# That signal arrives many minutes after the push, on a commit that is already
# public. This runs the same checks locally, in parallel, before the push
# leaves the machine (about as long as the slowest one, ~1-2 min).
#
# Enable:  git config core.hooksPath tools/git-hooks
# Bypass:  git push --no-verify
#
# Deliberately not a pre-commit hook: real friction per commit, negligible
# once per push.

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -f "$root/tools/generate.py" ] || exit 0

# Git exports repository-local variables to push hooks.  A generator that
# invokes a repo-relative helper with `git -C` must discover the worktree from
# that helper's path, not inherit the hook's gitdir as an implicit worktree.
git_local_env=$(git rev-parse --local-env-vars 2>/dev/null || :)
if [ -n "$git_local_env" ]; then
    # Intentional field splitting: rev-parse emits one variable name per line.
    # shellcheck disable=SC2086
    unset $git_local_env
fi

command -v python3 >/dev/null 2>&1 || {
    echo "pre-push: python3 not found; skipping the pre-push checks" >&2
    exit 0
}

logs=$(mktemp -d) || exit 0
trap 'rm -rf "$logs"' EXIT HUP INT TERM
set -- \
    "generate|python3 tools/generate.py --check" \
    "landing|python3 tools/render-landing.py --check" \
    "adaptation-boundary|./tools/check-adaptation-boundary.sh" \
    "model-config|python3 tools/check-model-config.py" \
    "unit-config|python3 tools/check-unit-config.py" \
    "scope-placeholders|python3 tools/check-scope-placeholders.py"
for check in "$@"; do
    name=${check%%|*}
    (cd "$root" && sh -c "${check#*|}" >"$logs/$name.log" 2>&1; echo $? >"$logs/$name.rc") &
done
wait

failed=""
for check in "$@"; do
    name=${check%%|*}
    rc=$(cat "$logs/$name.rc" 2>/dev/null || echo 1)
    if [ "$rc" != 0 ]; then
        failed="$failed $name"
        echo "--- pre-push: $name failed ---" >&2
        grep -E 'FAIL|ERROR|Error|stale|missing' "$logs/$name.log" | head -20 >&2
    fi
done
[ -z "$failed" ] && exit 0

cat >&2 <<MSG

pre-push: CI's adaptation-boundary job would fail this push:$failed
  stale projections: python3 tools/generate.py && git add -u && git commit --amend --no-edit
  bypass:            git push --no-verify
MSG
exit 1
